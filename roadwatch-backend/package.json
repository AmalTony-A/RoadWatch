  "description": "RoadWatch Node.js + Express backend with MongoDB, JWT auth, uploads, and admin/report APIs.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/server.js",
    "dev": "nodemon src/server.js",
