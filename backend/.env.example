APP_NAME=RoadWatch AI API
APP_ENV=development
DEMO_MODE=true
API_HOST=0.0.0.0
API_PORT=8000

# Optional MongoDB persistence (if missing, in-memory store is used)
MONGO_URI=
MONGO_DB=roadwatch_ai

# Optional YOLO model weights path
YOLO_MODEL_PATH=./models/yolov8n.pt

# Optional OpenAI key for LLM chatbot. If empty, rule-based chatbot runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Groq key for LLM chatbot. If set, Groq is used before OpenAI.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional Google AI Studio (Gemini) key. If set, Google is used before Groq.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# Mobile app URL for CORS
FRONTEND_ORIGIN=*
